!?*.[Cc]ache/

# Temporary and sensitive local files
~$*
*~
*.pfx
*.publishsettings

# Backup files
[Bb]ackup*/

# Python bytecode
**/__pycache__/
*.pyc

# MSBuild Binary and Structured Log
*.binlog
MSBuild_Logs/

